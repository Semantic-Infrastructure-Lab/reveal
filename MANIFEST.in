# Include plugin definitions
include plugins/*.yaml
include plugins/*.yml

# Include documentation
include README.md
include LICENSE
include CONTRIBUTING.md

# Include configuration
include pyproject.toml

# Exclude development files
exclude .gitignore
exclude .github/*
recursive-exclude tests *
recursive-exclude docs *
recursive-exclude * __pycache__
recursive-exclude * *.py[co]

# Include agent help documentation (in reveal/docs/ subdirectory)
recursive-include reveal/docs *.md

# Package data read at runtime (help:// topics, frontmatter schemas); declared so a
# build without git history ships them too (BACK-2154)
recursive-include reveal/adapters/help_data *.yaml
recursive-include reveal/schemas/frontmatter *.yaml
